{
  "name": "once-twice",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "once-twice",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "devDependencies": {
        "typescript": "~6.0.3"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "apps/api": {
      "name": "@once-twice/api",
      "version": "0.0.0",
      "license": "MIT",
      "dependencies": {
        "@once-twice/shared": "*"
      }
    },
    "apps/web": {
      "name": "@once-twice/web",
      "version": "0.0.0",
      "license": "MIT",
      "dependencies": {
        "@once-twice/shared": "*"
      }
    },
    "node_modules/@once-twice/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@once-twice/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@once-twice/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "6.0.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-6.0.3.tgz",
      "integrity": "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/shared": {
      "name": "@once-twice/shared",
      "version": "0.0.0",
      "license": "MIT"
    }
  }
}
